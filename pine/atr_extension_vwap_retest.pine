//@version=6
// ATR Extension -> VWAP Pullback -> Trend Continuation
//
// Trend-continuation setup. The move extends, pulls back COUNTER-TREND to VWAP,
// then resumes in the original direction. An up extension is a LONG setup.
//
// Stage 1 (ARM), during RTH:
//     market cap >= $500M
//     RVOL (time-of-day, anchored at the pre-market open) >= 1.5x
//     price >= 1.00 daily ATR from the opening price
//     price >= 0.75 daily ATR from VWAP
// Stage 2 (HEADS-UP = the alert), during RTH:
//     price pulls back to VWAP -> get ready, watch for the resumption
// Stage 3 (CONFIRMATION), during RTH:
//     price resumes in the direction of the original move
//
// ATR is the prior completed 14-day ATR, fixed for the whole session.
// VWAP and RVOL both accumulate from the PRE-MARKET open, so the chart must
// have Extended Hours enabled. The status table shows the live anchor time.

indicator("ATR Ext -> VWAP Pullback -> Continuation", "ATR Ext -> VWAP", overlay = true)

if timeframe.isdwm
    runtime.error("Use an intraday timeframe (1m-15m). Session VWAP is meaningless on daily or higher bars.")

// ─────────────────────────────────────────────────────────── Inputs ────────
grpF = "Filters"
atrLen   = input.int(14, "Daily ATR length", minval = 1, group = grpF)
openMult = input.float(1.00, "Min ATR extension from open", minval = 0, step = 0.05, group = grpF)
vwapMult = input.float(0.75, "Min ATR extension from VWAP", minval = 0, step = 0.05, group = grpF)
instMode = input.string("Stocks and ETFs", "Instruments", options = ["Stocks and ETFs", "Stocks only", "ETFs only"], group = grpF)
sizeMode = input.string("Auto", "Size gate", options = ["Auto", "Market cap only", "Dollar volume only", "Off"], group = grpF)
minMcapM = input.float(500, "Min market cap ($M) - stocks", minval = 0, step = 50, group = grpF)
minDolM  = input.float(25, "Min avg daily $ volume ($M) - ETFs", minval = 0, step = 5, group = grpF)
dvLen    = input.int(20, "Avg $ volume lookback (days)", minval = 1, group = grpF)
useRvol  = input.bool(true, "Require minimum RVOL", group = grpF)
minRvol  = input.float(1.5, "Min RVOL (time-of-day)", minval = 0, step = 0.1, group = grpF)
rvolDays = input.int(20, "RVOL lookback (sessions)", minval = 2, maxval = 30, group = grpF)
dirMode  = input.string("Both", "Direction", options = ["Both", "Up extensions", "Down extensions"], group = grpF)

grpA = "Anchors"
openAnchor = input.string("RTH open (09:30)", "Open reference", options = ["RTH open (09:30)", "Pre-market open"], group = grpA)

grpT = "Stage 2 - VWAP pullback (the alert)"
retestBuffer = input.float(0.10, "Fire this many ATR before VWAP is reached", minval = 0, step = 0.05, group = grpT)
maxBarsArm   = input.int(0, "Max bars from arm to pullback (0 = no limit)", minval = 0, group = grpT)

grpC = "Stage 3 - continuation"
confirmMode = input.string("Break retest extreme", "Confirmation", options = ["Break retest extreme", "Reclaim VWAP"], group = grpC)
minHold     = input.int(1, "Min bars between pullback and confirmation", minval = 0, group = grpC)
maxBarsConf = input.int(12, "Give up on the continuation after N bars (0 = never)", minval = 0, group = grpC)
invalidMult = input.float(0.25, "Invalidate if price closes this many ATR through VWAP", minval = 0, step = 0.05, group = grpC)
allowRearm  = input.bool(false, "Allow re-arm after a completed setup", group = grpC)

grpAl = "Alerts"
alertOn = input.string("VWAP pullback only", "alert() fires on", options = ["VWAP pullback only", "Continuation only", "Both"], group = grpAl)

grpD = "Display"
showBands = input.bool(true, "Draw ATR bands", group = grpD)
showTable = input.bool(true, "Show status table", group = grpD)

float minMcap = minMcapM * 1e6
float minDol   = minDolM * 1e6

// ────────────────────────────────────────────────── Session detection ──────
bool inRTH    = session.ismarket
bool inAnchor = session.ispremarket or session.ismarket   // 04:00 -> 16:00
bool newDay   = timeframe.change("D")
bool newAnchor = inAnchor and (nz(inAnchor[1] ? 1 : 0, 0) == 0 or newDay)
bool newRTH    = inRTH    and (nz(inRTH[1]    ? 1 : 0, 0) == 0 or newDay)

// ───────────────────────────────────────── Anchored VWAP + time-of-day RVOL ─
int maxSlots = math.max(2, int(math.ceil(86400.0 / timeframe.in_seconds())))
var matrix<float> hist   = matrix.new<float>(maxSlots, rvolDays, na)
var array<int>    colMax = array.new_int(rvolDays, -1)

var float cumPV      = na
var float cumVol     = na
var float pmOpen     = na
var int   anchorTime = na
var int   slot       = -1
var int   col        = -1

if newAnchor
    cumPV      := 0.0
    cumVol     := 0.0
    pmOpen     := open
    anchorTime := time
    slot       := 0
    col        := (col + 1) % rvolDays
    array.set(colMax, col, -1)
else if inAnchor
    slot := slot + 1

float avgCum = na
if inAnchor
    cumPV  := nz(cumPV)  + hlc3 * nz(volume)
    cumVol := nz(cumVol) + nz(volume)
    if slot >= 0 and slot < maxSlots
        // Average prior sessions' cumulative volume at THIS slot, skipping any
        // session that never reached it (half days, holidays).
        float s = 0.0
        int   n = 0
        for j = 0 to rvolDays - 1
            if j != col and array.get(colMax, j) >= slot
                float v = matrix.get(hist, slot, j)
                if not na(v)
                    s += v
                    n += 1
        avgCum := n > 0 ? s / n : na
        matrix.set(hist, slot, col, cumVol)
        array.set(colMax, col, slot)

float vwap   = nz(cumVol, 0) > 0 ? cumPV / cumVol : na
float rvol   = na(avgCum) or avgCum <= 0 ? na : cumVol / avgCum
bool  rvolOK = not useRvol or (not na(rvol) and rvol >= minRvol)

var float rthOpen = na
if newRTH
    rthOpen := open

// ───────────────────────────────── Daily ATR + size / instrument gates ─────
float dATR   = request.security(syminfo.tickerid, "D", ta.atr(atrLen)[1], lookahead = barmerge.lookahead_on)

// ETFs have no shares-outstanding data, so market cap is unavailable for them.
// AUM is not exposed to Pine either, so liquidity stands in: average daily
// dollar volume over the prior N completed days.
float shares = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol = true)
float mcap   = na(shares) ? na : shares * close
float advDol = request.security(syminfo.tickerid, "D", ta.sma(close * volume, dvLen)[1], lookahead = barmerge.lookahead_on)

// Fall back on data availability rather than on syminfo.type, so a fund that
// TradingView classifies unusually is still gated on something real.
bool hasFund = not na(mcap)
bool isFund  = syminfo.type == "fund"
bool typeOK  = instMode == "Stocks and ETFs" ? true : instMode == "ETFs only" ? isFund : not isFund

bool capPass = not na(mcap)   and mcap   >= minMcap
bool dolPass = not na(advDol) and advDol >= minDol
bool sizeOK  = sizeMode == "Off"                ? true :
               sizeMode == "Market cap only"    ? capPass :
               sizeMode == "Dollar volume only" ? dolPass :
               hasFund ? capPass : dolPass
bool usingDol = sizeMode == "Dollar volume only" or (sizeMode == "Auto" and not hasFund)

// ────────────────────────────────────────────────────────── Extension ──────
float openRef  = openAnchor == "Pre-market open" ? pmOpen : rthOpen
bool  haveRefs = not na(openRef) and not na(vwap) and not na(dATR) and dATR > 0
float openExt  = haveRefs ? (close - openRef) / dATR : na
float vwapExt  = haveRefs ? (close - vwap)    / dATR : na

bool allowUp = dirMode != "Down extensions"
bool allowDn = dirMode != "Up extensions"
bool gateOK  = inRTH and typeOK and sizeOK and rvolOK and haveRefs

bool armUpNow = gateOK and allowUp and openExt >=  openMult and vwapExt >=  vwapMult
bool armDnNow = gateOK and allowDn and openExt <= -openMult and vwapExt <= -vwapMult

// ─────────────────────────────────────────── Stage 1 -> 2 -> 3 state ──────
//  0 = flat
//  1 = armed long  (extended up)      2 = pulled back to VWAP, awaiting resumption
// -1 = armed short (extended down)   -2 = pulled back to VWAP, awaiting resumption
var int   state      = 0
var int   armBar     = na
var int   touchBar   = na
var float peakExt    = na
var float armRvol    = na
var float retestHigh = na
var float retestLow  = na
var bool  fired      = false

if newAnchor
    state      := 0
    armBar     := na
    touchBar   := na
    peakExt    := na
    armRvol    := na
    retestHigh := na
    retestLow  := na
    fired      := false

bool pullLong  = false
bool pullShort = false
bool confLong  = false
bool confShort = false

float nearBand  = nz(dATR, 0) * retestBuffer
float killBand  = nz(dATR, 0) * invalidMult

if state == 1
    peakExt := math.max(nz(peakExt, vwapExt), vwapExt)
    if maxBarsArm > 0 and bar_index - nz(armBar, bar_index) > maxBarsArm
        state := 0
    else if inRTH and low <= vwap + nearBand
        state      := 2
        touchBar   := bar_index
        retestHigh := high
        pullLong   := true
else if state == -1
    peakExt := math.min(nz(peakExt, vwapExt), vwapExt)
    if maxBarsArm > 0 and bar_index - nz(armBar, bar_index) > maxBarsArm
        state := 0
    else if inRTH and high >= vwap - nearBand
        state     := -2
        touchBar  := bar_index
        retestLow := low
        pullShort := true
else if state == 2
    // Pullback became a breakdown - this is no longer a continuation trade.
    if close < vwap - killBand
        state := 0
    else if maxBarsConf > 0 and bar_index - nz(touchBar, bar_index) > maxBarsConf
        state := 0
    else
        bool cond = confirmMode == "Reclaim VWAP" ? close > vwap : (high > retestHigh and close > vwap)
        if inRTH and cond and bar_index - nz(touchBar, bar_index) >= minHold
            confLong := true
            state    := 0
            fired    := true
        retestHigh := math.max(nz(retestHigh, high), high)
else if state == -2
    if close > vwap + killBand
        state := 0
    else if maxBarsConf > 0 and bar_index - nz(touchBar, bar_index) > maxBarsConf
        state := 0
    else
        bool cond = confirmMode == "Reclaim VWAP" ? close < vwap : (low < retestLow and close < vwap)
        if inRTH and cond and bar_index - nz(touchBar, bar_index) >= minHold
            confShort := true
            state     := 0
            fired     := true
        retestLow := math.min(nz(retestLow, low), low)

bool armedNow = false
if state == 0 and (allowRearm or not fired)
    if armUpNow
        state := 1
        armBar := bar_index
        peakExt := vwapExt
        armRvol := rvol
        armedNow := true
    else if armDnNow
        state := -1
        armBar := bar_index
        peakExt := vwapExt
        armRvol := rvol
        armedNow := true

// ──────────────────────────────────────────────────────────── Display ─────
plot(inAnchor ? vwap : na, "VWAP (PM anchored)", color.new(color.orange, 0), 2, plot.style_linebr)
plot(inRTH ? openRef : na, "Open reference", color.new(color.gray, 20), 1, plot.style_linebr)

plot(showBands and inRTH and haveRefs ? openRef + openMult * dATR : na, "Open +ATR", color.new(color.teal, 45), 1, plot.style_linebr)
plot(showBands and inRTH and haveRefs ? openRef - openMult * dATR : na, "Open -ATR", color.new(color.teal, 45), 1, plot.style_linebr)
plot(showBands and inRTH and haveRefs ? vwap + vwapMult * dATR : na, "VWAP +ATR", color.new(color.purple, 55), 1, plot.style_linebr)
plot(showBands and inRTH and haveRefs ? vwap - vwapMult * dATR : na, "VWAP -ATR", color.new(color.purple, 55), 1, plot.style_linebr)

// Small circle  = stage 1, extended and armed.
// "VWAP" label   = stage 2, pulled back. THIS IS THE ALERT - get ready.
// Triangle       = stage 3, continuation confirmed in the original direction.
plotshape(armedNow and state ==  1, "Armed long",  shape.circle, location.abovebar, color.new(color.teal, 30), size = size.tiny)
plotshape(armedNow and state == -1, "Armed short", shape.circle, location.belowbar, color.new(color.maroon, 30), size = size.tiny)
plotshape(pullLong,  "Long setup - pullback to VWAP",  shape.labelup,   location.belowbar, color.new(color.aqua, 0), text = "VWAP", textcolor = color.black, size = size.small)
plotshape(pullShort, "Short setup - pullback to VWAP", shape.labeldown, location.abovebar, color.new(color.fuchsia, 0), text = "VWAP", textcolor = color.white, size = size.small)
plotshape(confLong,  "Long continuation confirmed",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size = size.small)
plotshape(confShort, "Short continuation confirmed", shape.triangledown, location.abovebar, color.new(color.red,  0), size = size.small)

// Shade the window where a setup is live and you should be watching.
bgcolor(state ==  2 ? color.new(color.teal, 90) : state == -2 ? color.new(color.maroon, 90) : na, title = "Awaiting continuation")

// Pine Screener / data-window columns
plot(openExt,                         "Open ATR ext", display = display.data_window)
plot(vwapExt,                         "VWAP ATR ext", display = display.data_window)
plot(rvol,                            "RVOL",         display = display.data_window)
plot(na(mcap) ? na : mcap / 1e6,      "Mkt cap ($M)", display = display.data_window)
plot(na(advDol) ? na : advDol / 1e6,   "Avg $vol ($M)", display = display.data_window)
plot(state,                           "State",        display = display.data_window)
plot(pullLong ? 1 : pullShort ? -1 : 0, "VWAP pullback",  display = display.data_window)
plot(confLong ? 1 : confShort ? -1 : 0, "Continuation",   display = display.data_window)

// ────────────────────────────────────────────────────────── Alerting ───────
// Stage 2 - the heads-up. This is the one to put on your watchlist symbols.
alertcondition(pullLong,  "LONG setup: pullback to VWAP",  "Extended up, now pulled back to VWAP - watch for the resumption higher")
alertcondition(pullShort, "SHORT setup: pullback to VWAP", "Extended down, now pulled back to VWAP - watch for the resumption lower")
// Stage 3 - the confirmation, if you would rather be told when it actually goes.
alertcondition(confLong,  "LONG continuation confirmed",  "Resumed higher off VWAP")
alertcondition(confShort, "SHORT continuation confirmed", "Resumed lower off VWAP")

bool pullAny = pullLong or pullShort
bool confAny = confLong or confShort
bool sendPull = pullAny and (alertOn == "VWAP pullback only" or alertOn == "Both")
bool sendConf = confAny and (alertOn == "Continuation only"  or alertOn == "Both")

if sendPull
    alert(str.format("{0} {1} SETUP | pulled back to VWAP {2,number,#.####} | peak {3,number,#.##} ATR | RVOL {4,number,#.##}x | {5} | watch for continuation",
      syminfo.ticker, pullLong ? "LONG" : "SHORT", vwap, nz(peakExt), nz(armRvol),
      usingDol ? str.format("$vol ${0,number,#}M", nz(advDol) / 1e6) : str.format("mcap ${0,number,#}M", nz(mcap) / 1e6)),
      alert.freq_once_per_bar_close)
if sendConf
    alert(str.format("{0} {1} CONTINUATION confirmed at {2,number,#.####} | VWAP {3,number,#.####} | RVOL {4,number,#.##}x",
      syminfo.ticker, confLong ? "LONG" : "SHORT", close, vwap, nz(rvol)),
      alert.freq_once_per_bar_close)

// ──────────────────────────────────────────────────────── Status table ─────
var table t = table.new(position.top_right, 2, 8, border_width = 1)
if showTable and barstate.islast
    string st = state ==  1 ? "ARMED LONG"  : state ==  2 ? "AT VWAP - watch" :
                state == -1 ? "ARMED SHORT" : state == -2 ? "AT VWAP - watch" :
                fired ? "done for today" : "flat"
    color stc = math.abs(state) == 2 ? color.aqua : state != 0 ? color.yellow : color.silver
    table.cell(t, 0, 0, "VWAP anchor", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 0, na(anchorTime) ? "n/a" : str.format_time(anchorTime, "HH:mm", syminfo.timezone), text_size = size.small)
    table.cell(t, 0, 1, "Daily ATR", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, na(dATR) ? "n/a" : str.tostring(dATR, format.mintick), text_size = size.small)
    table.cell(t, 0, 2, usingDol ? "Avg $vol M" : "Mkt cap $M", text_color = color.gray, text_size = size.small)
    float sizeVal = usingDol ? advDol : mcap
    table.cell(t, 1, 2, na(sizeVal) ? "n/a" : str.tostring(sizeVal / 1e6, "#"), text_color = sizeOK ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 3, "RVOL", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, na(rvol) ? "n/a" : str.tostring(rvol, "#.##") + "x", text_color = rvolOK ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 4, "Open ext", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, na(openExt) ? "n/a" : str.tostring(openExt, "#.##") + " ATR", text_color = math.abs(nz(openExt)) >= openMult ? color.lime : color.silver, text_size = size.small)
    table.cell(t, 0, 5, "VWAP ext", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, na(vwapExt) ? "n/a" : str.tostring(vwapExt, "#.##") + " ATR", text_color = math.abs(nz(vwapExt)) >= vwapMult ? color.lime : color.silver, text_size = size.small)
    table.cell(t, 0, 6, "Peak ext", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 6, na(peakExt) ? "-" : str.tostring(peakExt, "#.##") + " ATR", text_size = size.small)
    table.cell(t, 0, 7, "State", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 7, st, text_color = stc, text_size = size.small)
